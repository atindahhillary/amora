# Postgres connection string. In production, the Supabase project's pooled connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/amora

# Public URL of this deployment, used for the M-Pesa callback.
APP_URL=http://localhost:3000

# 1 = no real SMS, M-Pesa or Smile ID calls. OTP codes show on screen, payments auto-confirm.
AMORA_MOCK_INTEGRATIONS=1

# Comma-separated phones (2547XXXXXXXX) that become matchmakers/admins on sign-in.
ADMIN_PHONES=254700000001

# Secret used to HMAC national ID numbers for duplicate detection. Never change after launch.
ID_HASH_PEPPER=change-me

# Protects /api/cron/tick. Call it every 15 minutes with header: Authorization: Bearer <secret>
CRON_SECRET=change-me

# Claude drafts profiles and "Why this match" notes. Without a key, template text is used.
ANTHROPIC_API_KEY=

# Africa's Talking SMS (use AT_USERNAME=sandbox for their sandbox)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Safaricom Daraja STK push
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Random string appended to the callback URL so only Safaricom's callback is accepted.
MPESA_CALLBACK_TOKEN=change-me
